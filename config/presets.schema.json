{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-flow.dev/schemas/presets.schema.json",
  "title": "Lore Flow Harness Presets",
  "description": "Model routing and execution policy for Lore Flow roles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "presets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor.normal",
        "cursor.heavy",
        "cursor.simple",
        "claude.normal",
        "claude.heavy"
      ],
      "properties": {
        "cursor.normal": {
          "$ref": "#/$defs/preset"
        },
        "cursor.heavy": {
          "$ref": "#/$defs/preset"
        },
        "cursor.simple": {
          "$ref": "#/$defs/preset"
        },
        "claude.normal": {
          "$ref": "#/$defs/preset"
        },
        "claude.heavy": {
          "$ref": "#/$defs/preset"
        }
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "harness", "mode", "approvalCheckpoints", "publishedPack", "roles"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "enum": ["cursor", "claude"]
        },
        "mode": {
          "enum": ["normal", "heavy", "simple"]
        },
        "approvalCheckpoints": {
          "$ref": "#/$defs/approvalCheckpoints"
        },
        "publishedPack": {
          "description": "Where the published review pack lives: committed to the target repository, kept local and git-excluded, or not minted.",
          "enum": ["committed", "local", "none"],
          "default": "committed"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orchestrator",
            "prd-reviewer",
            "discovery-frontend",
            "discovery-backend",
            "discovery-infra",
            "requirements-planner",
            "realign-run",
            "ponytail",
            "pr-sequencer",
            "builder-frontend",
            "builder-backend",
            "builder-infra",
            "final-reporter"
          ],
          "properties": {
            "orchestrator": { "$ref": "#/$defs/role" },
            "prd-reviewer": { "$ref": "#/$defs/role" },
            "discovery-frontend": { "$ref": "#/$defs/role" },
            "discovery-backend": { "$ref": "#/$defs/role" },
            "discovery-infra": { "$ref": "#/$defs/role" },
            "requirements-planner": { "$ref": "#/$defs/role" },
            "realign-run": { "$ref": "#/$defs/role" },
            "ponytail": { "$ref": "#/$defs/role" },
            "pr-sequencer": { "$ref": "#/$defs/role" },
            "builder-frontend": { "$ref": "#/$defs/role" },
            "builder-backend": { "$ref": "#/$defs/role" },
            "builder-infra": { "$ref": "#/$defs/role" },
            "final-reporter": { "$ref": "#/$defs/role" }
          }
        }
      }
    },
    "approvalCheckpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical-requirements", "pr-sequence"],
      "properties": {
        "technical-requirements": {
          "type": "boolean"
        },
        "pr-sequence": {
          "type": "boolean"
        },
        "each-pr": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "models",
        "effort",
        "concurrency",
        "retry",
        "reviewLoop"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "description": "Ordered model candidates; the first available candidate wins.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude-opus-5-thinking-high",
              "claude-opus-5-5-medium",
              "claude-sonnet-5-thinking-high",
              "composer-2.5-fast",
              "cursor-grok-4.5-high-fast",
              "cursor-grok-4.6-high-fast",
              "gpt-5.6-sol-medium",
              "gpt-5.6-terra-medium",
              "opus",
              "sonnet",
              "haiku"
            ]
          }
        },
        "effort": {
          "description": "Requested reasoning effort passed by the orchestrator.",
          "enum": ["low", "medium", "high", "max"]
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxInstances"],
          "properties": {
            "maxInstances": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoff"],
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "backoff": {
              "enum": ["none", "linear", "exponential"]
            }
          }
        },
        "reviewLoop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maxCycles", "reviewers"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxCycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "reviewers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["prd-reviewer", "ponytail"]
              }
            }
          }
        }
      }
    }
  }
}
